#!/usr/bin/env bash
# aurum-cuda-switch — rewires /usr/local/cuda to point at /usr/local/cuda-<ver>.
# Installed to /usr/local/libexec and invoked via pkexec from aurum-settings.
# Polkit policy: /usr/share/polkit-1/actions/org.aurumos.settings.policy.
#
# Doing this as a tiny shell helper (instead of from inside Qt) keeps the
# privilege boundary minimal: the elevated process touches a single symlink
# and exits.

set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "usage: aurum-cuda-switch <version>" >&2
    exit 2
fi

version="$1"
target="/usr/local/cuda-${version}"
link="/usr/local/cuda"

# Defense-in-depth: refuse anything that isn't a sane CUDA version string. The
# polkit action authorizes the binary as a whole; we still want to make it
# impossible for a malformed argument to symlink anywhere weird.
if [[ ! "${version}" =~ ^[0-9]+(\.[0-9]+)*$ ]]; then
    echo "[cuda-switch] refusing bogus version '${version}'" >&2
    exit 3
fi
if [[ ! -d "${target}" ]]; then
    echo "[cuda-switch] toolkit not installed at ${target}" >&2
    exit 4
fi

ln -sfn "${target}" "${link}"
echo "[cuda-switch] /usr/local/cuda → ${target}"
