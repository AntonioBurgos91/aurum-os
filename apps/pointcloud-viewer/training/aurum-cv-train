#!/usr/bin/env bash
# aurum-cv-train — thin launcher for the in-app point-cloud segmentation trainer.
# Installed to /usr/local/bin; runs the Python pipeline shipped under
# /usr/local/share/aurum-os/cv-training. The AurumOS ML stack (PyTorch) provides
# the runtime; on a CUDA host the trainer uses the GPU automatically.
set -euo pipefail
HERE="/usr/local/share/aurum-os/cv-training"
[ -d "$HERE" ] || HERE="$(cd "$(dirname "$0")" && pwd)"
exec python3 "$HERE/cv_train.py" "$@"
