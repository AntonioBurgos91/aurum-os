# AurumOS - System packages list
# This list defines the baseline system tools, libraries, editors, and display protocols.

# --- Build Toolchains and Runtimes ---
build-essential
gcc-14
g++-14
clang-18
lld-18
cmake
git
git-lfs
pkg-config
curl
wget
libvulkan-dev
libwlroots-dev
libwayland-dev
wayland-protocols
libxkbcommon-dev
libinput-dev
libdbus-1-dev
pipewire
wireplumber
bcachefs-tools
zram-config

# --- UI Framework Libraries (Qt6) ---
# -dev packages provide headers for the C++ build; the qml6-module-* packages
# provide the *runtime* plugins the binaries load when they `import QtQuick.*`.
# Without these the desktop binaries start but every `import` fails silently.
qt6-base-dev
qt6-declarative-dev
qt6-wayland
qt6-multimedia-dev
libqt6svg6
qml6-module-qtquick
qml6-module-qtquick-controls
qml6-module-qtquick-layouts
qml6-module-qtquick-window
qml6-module-qtquick-dialogs
qml6-module-qtquick-templates
qml6-module-qtqml
qml6-module-qtqml-workerscript
qml6-module-qtqml-models

# --- User Workspace Shells & Tools ---
fish
starship
zellij
lazygit
gitui
neovim
fzf
ripgrep
fd-find
htop
btop
ufw
gufw

# --- GUI Desktop and Apps (Custom themes & Native utilities) ---
# Hyprland itself is built from source by distro/iso-builder/build-hyprland.sh
# and installed to /usr/local, so we deliberately do NOT pull the apt package.
# Listed below are its runtime peers and the macOS-UX support tools.
xdg-desktop-portal-hyprland
kitty
swaybg
swww
mako-notifier
waybar
wlogout
grim
slurp
wl-clipboard
cliphist
fuzzel
brightnessctl
playerctl
polkit-kde-agent-1
qt6ct

# Dev Editors
# zed - installed via official script
# jetbrains-toolbox - installed via preinstall script

# --- Wave 10 Agent C — Typography (fonts-inter + JetBrains Mono) ----------------
# The Aurum.Aqua Theme singleton declares font.family="Inter" / "Inter Display" /
# "JetBrains Mono". These apt packages provide the OFL-licensed equivalents of
# Apple's SF Pro family (which we cannot redistribute). install-fonts.sh runs
# fc-cache and writes /etc/fonts/conf.d/99-aurum-fonts.conf so sans-serif and
# monospace resolve to these instead of DejaVu.
fonts-inter
fonts-jetbrains-mono
fonts-dejavu-core
fontconfig

# --- Wave 10 Agent B — Icon system (gtk-update-icon-cache) ---------------------
# install-icons.sh runs gtk-update-icon-cache when it lands the file-type SVGs
# under /usr/share/icons/Aurum-Sequoia/. libgtk-3-bin ships that binary; it is
# usually pulled in transitively but pinning it explicitly avoids icon-cache
# refresh failures on minimal installs.
libgtk-3-bin

# --- Wave 10 Agent D — Wallpapers (cargo runtime + libpng) ---------------------
# aurum-wallpaper-gen is a Rust+tiny-skia binary. The crate is built ONCE on a
# developer/CI machine (gen.sh in the crate dir) and the resulting PNGs are
# committed to distro/seed/wallpapers/. The ISO itself only needs libpng16-16
# (always present) to display them. NO rust toolchain in the runtime image.
