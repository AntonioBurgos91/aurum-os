# AurumOS - Deep Learning Packages List
# This file defines the deep learning, GPU runtimes, and MLOps packages preinstalled on AurumOS.

# --- GPU Runtimes and Drivers (Apt packages) ---
# Note: Pop!_OS already comes with driver-select and nvidia-cuda-toolkit, we enforce specific runtimes.
cuda-toolkit-12-6
libcudnn9-cuda-12
libnccl2
libnccl-dev
tensorrt
tensorrt-dev
nvtop
gpustat
podman
podman-docker
nvidia-container-toolkit

# --- CPU/AMD Support (Optional) ---
# rocm-dev
# rocminfo

# --- Python & Package Managers ---
# uv is installed globally as a Rust binary
# Runtimes managed by uv: Python 3.13

# --- Python/ML Packages installed globally or in default system venv ---
# Runtimes and baseline libraries
numpy
scipy
pandas
polars
duckdb
matplotlib
seaborn
scikit-learn

# Deep Learning Frameworks
torch==2.5.1
torchvision
torchaudio
jax[cuda12]
flax
tensorflow[and-cuda]

# Large Language Model & Inference Frameworks
vllm
llama-cpp-python
triton
bitsandbytes

# Optimization & Fine-tuning
# unsloth
# flash-attn

# MLOps & Tracking
mlflow
wandb
dvc[s3,gdrive]
hydra-core
pytorch-lightning

# Interactive Environments (installed as uv tools / global bin)
jupyterlab
marimo

# Datasets and Hubs
huggingface_hub[cli]
kaggle

# AI Developer Tools (Global tools via uv tool)
# aider-chat
# open-interpreter
# claude-code
